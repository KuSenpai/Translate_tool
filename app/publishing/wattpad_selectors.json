{
  "_comment": "Wattpad UI selectors. Wattpad has no public API for creating parts, so the publisher drives the website. If Wattpad changes its UI, update the candidates here (first match wins) — no code change needed. Playwright selector syntax.",
  "ext": {
    "_comment": "Used by the browser extension (plain CSS for querySelector; *_texts are exact button labels, case-insensitive). Served live from /api/ext/config, so editing this file needs no extension reinstall.",
    "_comment_real": "Checked against the real site (Edge, Oct 2026). Story page /myworks/<id> = 'Edit Story Details' with the parts list (a.on-navigate -> /myworks/<id>/write/<part>, oldest first, each row 'Published|Draft - date'); its '+ New Part' button (button.on-new-part) only adds a blank draft and opens nothing, so it is NOT used. Editor /myworks/<id>/write/<part>: title h2#story-title[contenteditable], text div.story-editor (MediumEditor), header .navbar-story-parts (title, 'Draft|Published', '(N Words)'), Publish/Save/Preview, and 'New Part' (button.on-newpart) inside the parts dropdown, hidden until the header is clicked. Publish asks for confirmation with the browser's own confirm() popup (answered by extension/page_hook.js).",
    "new_part_selectors": ["button.on-newpart"],
    "parts_menu_toggles": [".navbar-story-parts"],
    "parts_menu_roots": [".navbar-story-metadata"],
    "part_header_selectors": [".navbar-story-parts"],
    "published_texts": ["published", "đã xuất bản", "đã đăng"],
    "draft_texts": ["draft", "bản nháp"],
    "new_part_texts": ["new part", "+ new part", "add part", "add a part", "+ add part", "write a new part",
                       "phần mới", "+ phần mới", "thêm phần mới", "tạo phần mới", "viết phần mới", "thêm phần"],
    "title_selectors": ["#story-title", "[data-testid='part-title'] textarea", "[data-testid='part-title'] input",
                        "textarea[placeholder*='untitled' i]", "input[placeholder*='untitled' i]",
                        "textarea[placeholder*='tiêu đề' i]", "input[placeholder*='tiêu đề' i]",
                        "[contenteditable='true'][data-placeholder*='untitled' i]", "[contenteditable='true'][data-placeholder*='tiêu đề' i]"],
    "body_selectors": [".story-editor[contenteditable='true']", "#storytext", "[data-testid='editor'] [contenteditable='true']",
                       ".editor [contenteditable='true']"],
    "save_texts": ["save", "lưu", "lưu nháp", "save draft"],
    "publish_texts": ["publish", "xuất bản", "đăng", "đăng tải", "đăng bài", "publish part", "xuất bản phần"],
    "_comment_confirm": "Popup shown after clicking Publish. It is found even without role=dialog/modal classes (the layer covering the Publish button, or new buttons that appeared). Only these labels are ever clicked inside it.",
    "confirm_texts": ["publish", "xuất bản", "đăng", "đăng tải", "publish part", "publish now", "yes, publish", "đăng ngay",
                      "xuất bản ngay", "ok", "yes", "có", "xác nhận", "confirm", "continue", "tiếp tục"],
    "unpublish_texts": ["unpublish", "hủy đăng", "huỷ đăng", "hủy xuất bản", "huỷ xuất bản"],
    "bad_label_words": ["unpublish", "cancel", "schedule", "setting", "option", "later", "draft", "preview",
                        "hủy", "huỷ", "lên lịch", "cài đặt", "xem trước", "nháp"],
    "error_texts": ["something went wrong", "try again", "failed", "couldn't", "could not", "unable to", "can't publish",
