# Copy to .env and fill in. Never commit .env.

# --- Server ---
APP_HOST=127.0.0.1
APP_PORT=8765

# --- AI correction ---
# LLM_PROVIDER: anthropic | openai | local | mock   (empty = AI disabled)
#   mock  = offline fake provider (spacing + glossary fixes only) for trying the UI
LLM_PROVIDER=mock
# Model name. anthropic default: claude-opus-5. Required for openai/local.
LLM_MODEL=
# Seconds before an AI request times out
LLM_TIMEOUT=90
# Anthropic only, optional: low | medium | high | xhigh | max
LLM_EFFORT=

# Whole-novel translation (🤖 Dịch AI) uses Claude and needs ANTHROPIC_API_KEY.
# TRANSLATE_PROVIDER=mock tries the screen without calling the API.
TRANSLATE_PROVIDER=anthropic
# Antigravity (Gemini via the `agy` CLI): model slugs are picked from `agy models`; override here if needed.
ANTIGRAVITY_MODEL_PRO=
ANTIGRAVITY_MODEL_FLASH=
ANTIGRAVITY_CLI_PATH=
ANTHROPIC_API_KEY=
# Grok (xAI) — dịch được truyện 18+. Key lấy ở console.x.ai (tính tiền theo token).
XAI_API_KEY=
# Slug model Grok: XAI_MODEL = bản mạnh, XAI_MODEL_FAST = bản rẻ (mặc định grok-4.7 / grok-4.3; xem danh sách trong tool)
XAI_MODEL=
XAI_MODEL_FAST=
OPENAI_API_KEY=
# local = any OpenAI-compatible server (Ollama, LM Studio, llama.cpp ...)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=

# --- Wattpad ---
# extension  = publish from your everyday Edge through the helper extension in extension/ (recommended:
#              uses your own Wattpad login incl. Google/Facebook, and your VPN extension)
# playwright = a separate automated Edge window (Google login is usually blocked there)
WATTPAD_MODE=extension
# Browser used by Playwright: empty = bundled Chromium (run: python -m playwright install chromium),
# or "msedge" / "chrome" to use the browser already installed on this machine.
WATTPAD_BROWSER_CHANNEL=msedge
# Wattpad blocked on your network? Turn on/install a VPN extension in the Edge window the tool
# opens (it is remembered), use a system-wide VPN, or set your VPN app's local proxy here:
#   WATTPAD_PROXY=http://127.0.0.1:7890   or   socks5://127.0.0.1:1080
WATTPAD_PROXY=
# Seconds to wait for you to finish logging in manually
WATTPAD_LOGIN_TIMEOUT=600
# Keep false: you can watch every step and intervene
WATTPAD_HEADLESS=false
